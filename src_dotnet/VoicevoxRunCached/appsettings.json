{
  "Synthesis": {
    // Speech engine used by default (overridable with --engine): Voicevox | Voicepeak | Cevio
    "Engine": "Voicevox"
  },
  "VoiceVox": {
    // VOICEVOX settings (default)
    "EngineType": "VOICEVOX",
    "BaseUrl": "http://127.0.0.1:50021",
    "EngineArguments": "--host 127.0.0.1 --port 50021",
    "DefaultSpeaker": 1,

    // To use AIVIS Speech instead, change to:
    // "EngineType": "AivisSpeech",
    // "BaseUrl": "http://127.0.0.1:10101",
    // "EngineArguments": "--host 127.0.0.1 --port 10101",
    // "DefaultSpeaker": 888753760,

    "EnginePath": "",
    "ConnectionTimeout": 30,
    "AutoStartEngine": true,
    "StartupTimeoutSeconds": 30,
    "KeepEngineRunning": true,
    // Fillers for this engine. FillerTexts: empty = Filler.FillerTexts
    // MaxFillersPerWait (not set here): fillers per wait for the next sentence (null or omitted = no limit, 0 = none)
    "FillerTexts": []
  },
  "Cache": {
    "Directory": "./cache/audio/",
    "UseExecutableBaseDirectory": true,
    "ExpirationDays": 30,
    "MaxSizeGB": 1.0,
    // Opus のビットレート (kbps, VBR)。12-128。キャッシュ・フィラー (--init)・--out .opus に使う
    // キャッシュキーには含まれないので、変更後に全体を作り直したい場合は --clear する
    "OpusBitrateKbps": 32
  },
  "Audio": {
    "OutputDevice": -1,
    // 再生時の音量。0.0-1.0 の範囲 (WaveOut の上限が 1.0)。キャッシュ・--out には影響しない。音声そのものの音量は --volume
    "Volume": 1.0,
    "PrepareDevice": false,
    "PreparationDurationMs": 200,
    "PreparationVolume": 0.01,
    // WaveOut の希望レイテンシ (ms。全バッファの合計)。10-1000 の範囲
    "DesiredLatency": 100,
    // WaveOut のバッファ数。1-10 の範囲
    "NumberOfBuffers": 3
  },
  "Filler": {
    // 初回利用時は --init でフィラーキャッシュを生成してから true にすること
    "Enabled": false,
    "Directory": "./cache/filler/",
    "UseExecutableBaseDirectory": true,
    "FillerTexts": [
      "えーっと、",
      "あのー、",
      "あのう、",
      "ええと、",
      "ええっと、",
      "えとえと、"
    ]
  },
  "Lock": {
    // 先に動いている読み上げなどが終わるのを待つ上限 (秒)。未設定なら上限なし、0 なら待たない。
    // 上限を超えたら実行せず終了コード 9 で終わる (Hooks が続けて発火したとき、古い通知を後から読まないため)。
    // 読み上げでは --max-wait <秒> で上書きできる
    // "MaxWaitSeconds": 10
  },
  "Logging": {
    // Level: trace|debug|info|warn|error|crit|none
    "Level": "info",
    // Format: simple|json
    "Format": "simple",
    // ファイルログ出力の有効化
    "EnableFileLogging": false,
    // ログファイル単体の最大サイズ (MB)。EnableFileLogging=true の時のみ検証
    "MaxFileSizeMb": 10,
    // ログローテーションで保持するファイル数。EnableFileLogging=true の時のみ検証
    "MaxFileCount": 5
  },
  "Test": {
    "Message": "テストを開始します。温度は25.5℃、湿度は60%、風速は3.2km/hです。合計は￥1,980、割引後は1/2で￥990です。APIやTTS、MP3・WAVの再生を確認します。URLはhttps://example.com、メールはtest@test.comです。電話番号は03-1234-5678、「かっこ（括弧）」や\"ダブルクォート\"の読み上げもテストします。最後に、VoicevoxRunCachedのテストは以上です！"
  },
  "Voicepeak": {
    // VOICEPEAK (--engine voicepeak). voicepeak.exe takes about 10 seconds per sentence; cached sentences play instantly
    // Empty = %ProgramFiles%\VOICEPEAK\voicepeak.exe
    "ExePath": "",
    // Narrator name, optionally with emotions: "Otomachi Una" / "Otomachi Una:joy=50" (see: speakers --engine voicepeak)
    // Empty = --speaker is required with --engine voicepeak
    "DefaultSpeaker": "",
    // Seconds to wait for one voicepeak.exe run (10-600)
    "TimeoutSeconds": 60,
    // Fillers for this engine: longer ones, since each sentence takes about 10 seconds (regenerate with --init --engine voicepeak -s <narrator>)
    "FillerTexts": [
      "えーっと、ちょっと待ってくださいね、",
      "少々お待ちください、",
      "ええと、今まとめていますので、",
      "あのー、もう少しお待ちください、"
    ],
    // Fillers per wait for the next sentence (null = no limit, 0 = none). Omitted = 2, so write null to remove the limit
    "MaxFillersPerWait": 2
  },
  "Cevio": {
    // CeVIO AI (--engine cevio) の設定
    // -s を省略したときのキャスト名 (speakers --engine cevio で確認)。感情は "キャスト名:嬉しい=50,普通=50" のように書く
    // 空なら --engine cevio のとき -s が必須
    "DefaultSpeaker": "",
    // CeVIO AI が起動していなければ起動する
    "AutoStartHost": true,
    // CeVIO AI.exe のパス。空なら %ProgramFiles%\CeVIO\CeVIO AI\CeVIO AI.exe
    "HostPath": "",
    "StartupTimeoutSeconds": 60,
    // 自分で起動した CeVIO AI を読み上げの後も残す (false なら終わるときに閉じる。CeVIO AI は常にウィンドウを表示する)
    "KeepHostRunning": true,
    // CeVIO AI の呼び出し (1 文の合成など) を待つ上限 (秒)。途中で CeVIO AI が閉じられたときに止まらないため
    "SynthesisTimeoutSeconds": 30,
    // このエンジンのフィラー。FillerTexts: 空なら Filler.FillerTexts
    // MaxFillersPerWait (ここでは未設定): 次の文を待つ 1 回に鳴らす数 (null か省略 = 上限なし、0 = 鳴らさない)
    "FillerTexts": []
  }
}
