{
  "Synthesis": {
    // 既定の合成エンジン (--engine で上書きできる): Voicevox | Voicepeak | Cevio
    "Engine": "Voicevox"
  },
  "VoiceVox": {
    // VOICEVOX (既定のエンジン) の設定
    // VOICEVOX | AivisSpeech
    "EngineType": "VOICEVOX",
    // localhost より 127.0.0.1 がよい (名前解決の遅れを避ける)
    "BaseUrl": "http://127.0.0.1:50021",
    // エンジンを自動で起動するときに渡す引数
    "EngineArguments": "--host 127.0.0.1 --port 50021",
    // -s を省略したときの話者 (スタイル) の ID。speakers で確認する
    "DefaultSpeaker": 1,

    // 代わりに AivisSpeech を使うときは次のように変える:
    // "EngineType": "AivisSpeech",
    // "BaseUrl": "http://127.0.0.1:10101",
    // "EngineArguments": "--host 127.0.0.1 --port 10101",
    // "DefaultSpeaker": 888753760,

    // エンジンの exe。空ならインストール場所から自動で探す (VOICEVOX 0.26 以降の %APPDATA%\voicevox\vvpp-engines\ も探す)
    "EnginePath": "",
    // HTTP リクエスト 1 回を待つ上限 (秒)。タイムアウトはリトライしない。話者の初期化 (モデルの読み込み) は完了まで待つ
    "ConnectionTimeout": 30,
    // エンジンが動いていなければ起動する (合成が必要になったときだけ)
    "AutoStartEngine": true,
    "StartupTimeoutSeconds": 30,
    // false なら、自分で起動したエンジンを合成が終わった時点で止める (強制終了されたときは残る)。外部で起動済みのエンジンは止めない
    "KeepEngineRunning": true,
    // このエンジンのフィラー。FillerTexts: 空なら Filler.FillerTexts
    // MaxFillersPerWait (ここでは未設定): 次の文を待つ 1 回に鳴らす数 (null か省略 = 上限なし、0 = 鳴らさない)
    "FillerTexts": []
  },
  "Cache": {
    // 音声のキャッシュの保存先。起動時に書き込めるか確かめる
    "Directory": "./cache/audio/",
    // true なら相対パスを exe のフォルダ基準で、false ならカレントディレクトリ基準で解決する
    "UseExecutableBaseDirectory": true,
    // 最後に使ってからこの日数を過ぎたキャッシュを消す (使うたびに延長される)
    "ExpirationDays": 30,
    // 合計がこれを超えたら、最後に使ったのが古い順に消す
    "MaxSizeGB": 1.0,
    // Opus のビットレート (kbps, VBR)。12-128。キャッシュ・フィラー (--init)・--out .opus に使う
    // キャッシュキーには含まれないので、変更後に全体を作り直したい場合は --clear する
    "OpusBitrateKbps": 32
  },
  "Audio": {
    // 再生デバイス。-1 = OS 既定、0 以上 = devices で表示される番号 (SpeakerDevices に無い話者はここで鳴る)
    "OutputDevice": -1,
    // 話者ごとの再生デバイス。例: [{ "Engine": "Voicevox", "Speaker": "3", "Device": 1 }] (README の「再生デバイスを選ぶ」)
    "SpeakerDevices": [],
    // 再生時の音量。0.0-1.0 の範囲 (WaveOut の上限が 1.0)。キャッシュ・--out には影響しない。音声そのものの音量は --volume
    "Volume": 1.0,
    // true なら再生の前に小さな音を流してデバイスを温める (USB / Bluetooth で冒頭が途切れるとき。読み上げで再生するときだけ)
    "PrepareDevice": false,
    "PreparationDurationMs": 200,
    "PreparationVolume": 0.01,
    // WaveOut の希望レイテンシ (ms。全バッファの合計)。10-1000 の範囲
    "DesiredLatency": 100,
    // WaveOut のバッファ数。1-10 の範囲
    "NumberOfBuffers": 3
  },
  "Filler": {
    // 合成を待つ間にフィラーを鳴らす。先に --init でフィラーを生成してから true にする
    "Enabled": false,
    // フィラーの保存先。Cache.Directory と同じにはできない
    "Directory": "./cache/filler/",
    "UseExecutableBaseDirectory": true,
    "FillerTexts": [
      "えーっと、",
      "あのー、",
      "あのう、",
      "ええと、",
      "ええっと、",
      "えとえと、"
    ]
  },
  "Lock": {
    // 先に動いている読み上げなどの順番待ちの上限 (秒)。未設定なら上限なし、0 なら待たない。
    // 読み上げでは、合成と再生 (同じデバイス) の順番待ちを合わせた時間で数える。
    // 上限を超えたら実行せず終了コード 9 で終わる (Hooks が続けて発火したとき、古い通知を後から読まないため)。
    // 読み上げでは --max-wait <秒> で上書きできる
    // "MaxWaitSeconds": 10
  },
  "Logging": {
    // Level: trace|debug|info|warn|error|crit|none
    "Level": "info",
    // Format: simple|json (json は 1 イベント 1 行。コンソール・ファイル共通)
    "Format": "simple",
    // true なら exe のフォルダの logs\voicevox-run-cached-YYYYMMDD.log にも出す (日ごと)
    "EnableFileLogging": false,
    // ログファイル単体の最大サイズ (MB)。EnableFileLogging=true の時のみ検証
    "MaxFileSizeMb": 10,
    // ログローテーションで保持するファイル数。EnableFileLogging=true の時のみ検証
    "MaxFileCount": 5
  },
  "Test": {
    // --test で読み上げる文
    "Message": "テストを開始します。温度は25.5℃、湿度は60%、風速は3.2km/hです。合計は￥1,980、割引後は1/2で￥990です。APIやTTS、MP3・WAVの再生を確認します。URLはhttps://example.com、メールはtest@test.comです。電話番号は03-1234-5678、「かっこ（括弧）」や\"ダブルクォート\"の読み上げもテストします。最後に、VoicevoxRunCachedのテストは以上です！"
  },
  "Voicepeak": {
    // VOICEPEAK (--engine voicepeak) の設定。voicepeak.exe は 1 文に 10 秒ほどかかる (キャッシュ済みの文はすぐ鳴る)
    // voicepeak.exe のパス。空なら %ProgramFiles%\VOICEPEAK\voicepeak.exe
    "ExePath": "",
    // -s を省略したときのナレーター名 (speakers --engine voicepeak で確認)。感情は "Otomachi Una:joy=50" のように書く
    // 空なら --engine voicepeak のとき -s が必須
    "DefaultSpeaker": "",
    // voicepeak.exe 1 回の実行を待つ上限 (秒。10-600)
    "TimeoutSeconds": 60,
    // このエンジンのフィラー。1 文に 10 秒ほどかかるので長めにする (変えたら --init --engine voicepeak -s <ナレーター名> で作り直す)
    "FillerTexts": [
      "えーっと、ちょっと待ってくださいね、",
      "少々お待ちください、",
      "ええと、今まとめていますので、",
      "あのー、もう少しお待ちください、"
    ],
    // 次の文を待つ 1 回に鳴らす数 (null = 上限なし、0 = 鳴らさない)。省略すると 2 なので、上限をなくすには null と書く
    "MaxFillersPerWait": 2
  },
  "Cevio": {
    // CeVIO AI (--engine cevio) の設定
    // -s を省略したときのキャスト名 (speakers --engine cevio で確認)。感情は "キャスト名:嬉しい=50,普通=50" のように書く
    // 空なら --engine cevio のとき -s が必須
    "DefaultSpeaker": "",
    // CeVIO AI が起動していなければ起動する
    "AutoStartHost": true,
    // CeVIO AI.exe のパス。空なら %ProgramFiles%\CeVIO\CeVIO AI\CeVIO AI.exe
    "HostPath": "",
    "StartupTimeoutSeconds": 60,
    // 自分で起動した CeVIO AI を読み上げの後も残す (false なら終わるときに閉じる。CeVIO AI は常にウィンドウを表示する)
    "KeepHostRunning": true,
    // CeVIO AI の呼び出し (1 文の合成・閉じるなど) を待つ上限 (秒)。途中で CeVIO AI が閉じられたときに止まらないため
    "SynthesisTimeoutSeconds": 30,
    // このエンジンのフィラー。FillerTexts: 空なら Filler.FillerTexts
    // MaxFillersPerWait (ここでは未設定): 次の文を待つ 1 回に鳴らす数 (null か省略 = 上限なし、0 = 鳴らさない)
    "FillerTexts": []
  }
}
