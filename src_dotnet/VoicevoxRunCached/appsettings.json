{
  "VoiceVox": {
    // VOICEVOX settings (default)
    "EngineType": "VOICEVOX",
    "BaseUrl": "http://127.0.0.1:50021",
    "EngineArguments": "--host 127.0.0.1 --port 50021",
    "DefaultSpeaker": 1,

    // To use AIVIS Speech instead, change to:
    // "EngineType": "AivisSpeech",
    // "BaseUrl": "http://127.0.0.1:10101",
    // "EngineArguments": "--host 127.0.0.1 --port 10101",
    // "DefaultSpeaker": 888753760,

    "EnginePath": "",
    "ConnectionTimeout": 30,
    "AutoStartEngine": true,
    "StartupTimeoutSeconds": 30,
    "KeepEngineRunning": true
  },
  "Cache": {
    "Directory": "./cache/audio/",
    "UseExecutableBaseDirectory": true,
    "ExpirationDays": 30,
    "MaxSizeGB": 1.0,
    // キャッシュ保存時の MP3 ビットレート (kbps)。32/40/48/56/64/80/96/112/128/160/192/224/256/320
    // キャッシュキーには含まれないので、変更後に全体を作り直したい場合は --clear する
    "Mp3BitrateKbps": 64
  },
  "Audio": {
    "OutputDevice": -1,
    "Volume": 1.2,
    "PrepareDevice": false,
    "PreparationDurationMs": 200,
    "PreparationVolume": 0.01,
    // WaveOutEvent の希望レイテンシ (ms)。10-1000 の範囲
    "DesiredLatency": 100,
    // WaveOutEvent のバッファ数。1-10 の範囲
    "NumberOfBuffers": 3
  },
  "Filler": {
    // 初回利用時は --init でフィラーキャッシュを生成してから true にすること
    "Enabled": false,
    "Directory": "./cache/filler/",
    "UseExecutableBaseDirectory": true,
    "FillerTexts": [
      "えーっと、",
      "あのー、",
      "あのう、",
      "ええと、",
      "ええっと、",
      "えとえと、"
    ]
  },
  "Logging": {
    // Level: trace|debug|info|warn|error|crit|none
    "Level": "info",
    // Format: simple|json
    "Format": "simple",
    // ファイルログ出力の有効化
    "EnableFileLogging": false,
    // ログファイル単体の最大サイズ (MB)。EnableFileLogging=true の時のみ検証
    "MaxFileSizeMb": 10,
    // ログローテーションで保持するファイル数。EnableFileLogging=true の時のみ検証
    "MaxFileCount": 5
  },
  "Test": {
    "Message": "テストを開始します。温度は25.5℃、湿度は60%、風速は3.2km/hです。合計は￥1,980、割引後は1/2で￥990です。APIやTTS、MP3・WAVの再生を確認します。URLはhttps://example.com、メールはtest@test.comです。電話番号は03-1234-5678、「かっこ（括弧）」や\"ダブルクォート\"の読み上げもテストします。最後に、VoicevoxRunCachedのテストは以上です！"
  }
}
