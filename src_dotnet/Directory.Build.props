<Project>

  <!--
    src_dotnet/ 配下の全プロジェクト共通プロパティ。
    各 csproj 側で上書きしたい項目はそのまま個別指定すれば優先される。
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!--
      アプリのバージョンはここ 1 箇所で管理する。
      AssemblyVersion / FileVersion は SDK が Version から自動生成するので個別指定しない。
    -->
    <Version>3.0.0</Version>
  </PropertyGroup>

  <!--
    再生 (WinMM) とデバイス列挙 (WASAPI) が Windows 専用なので、全プロジェクトを Windows 専用と宣言する。
    NAudio 3 は Windows 専用 API に SupportedOSPlatform("windows") を付けており、宣言しないと CA1416 になる
    (テストも本体の型を通じて同じ警告になるため、ここで共通に付ける)。
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
